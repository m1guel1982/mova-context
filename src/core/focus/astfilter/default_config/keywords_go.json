{
  "language": "go",
  "extensions": [".go"],
  "kinds": {
    "func": [
      { "type": "function_declaration" },
      { "type": "method_declaration" }
    ],
    "class": [
      { "type": "type_spec" }
    ],
    "struct": [
      { "type": "type_spec", "requires_child_type": "struct_type" }
    ],
    "interface": [
      { "type": "type_spec", "requires_child_type": "interface_type" }
    ],
    "type": [
      { "type": "type_spec" }
    ],
    "namespace": [
      { "type": "package_clause" }
    ],
    "const": [
      { "type": "const_spec" }
    ],
    "var": [
      { "type": "var_spec" }
    ],
    "comment": [
      { "type": "comment" }
    ]
  }
}
