    "config": "lfm2.5-1.2b"
  },

  "budget": {
    "max_tokens": 16000
  },
  
  "token_history_path": "/projects/chat-generico/mova-token-history.json",
  "budget_path": "/projects/chat-generico/mova-budget-example-report.md"

}