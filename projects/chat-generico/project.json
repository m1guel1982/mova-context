{
  "project": "chat-generico",
  "description": "Consola de chat libre multipropósito sin restricciones de contexto ni especialidad",
  "repo": ".",
  "lang": "es",
  "adapter": "file",
  "default_task": "libre",

  "tasks": {
    "libre": {
      "prompt": "general-assistant",
      "variables": {},
      "focus": []
    }
